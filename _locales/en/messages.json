    "message": "Recording is capped at 1 minute. Pin the icon in the toolbar (puzzle menu → 📌) so it's always one click away."
  },
  "welcomeStep2Title": {
    "message": "Press $KBD$ to spot something",
    "placeholders": { "kbd": { "content": "$1" } }
  },
  "welcomeStep2Body": {
    "message": "Your cursor becomes a reticle. Drag a box around the problem, type a note, then $KBD$ to confirm. Spot mode turns off automatically — press the shortcut again for the next one.",
