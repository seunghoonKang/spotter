  },
  "welcomeStep3Title": {
    "message": "Stop. Get a single-file $REPORT$.",
    "placeholders": { "report": { "content": "$1" } }
  },
  "welcomeStep3TitleReport": { "message": "HTML report" },
  "welcomeStep3Body": {
    "message": "Video, every spot with a screenshot, every meaningful click, plus console errors and failed requests — all in one .html attachment. Open with one double-click."
  },
  "welcomeCta": { "message": "Try it now" },
  "welcomeFootnote": {
    "message": "Tip: if you opened a tab before installing Spotter, refresh it once. Spotter doesn't work on $CHROME_URL$ pages or the Chrome Web Store.",
